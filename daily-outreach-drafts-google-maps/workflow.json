    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Collect the domains already in the sheet and pick today's search.\n// Rotation: every search × city pair in Settings, one pair per weekday, so Maps keeps finding new companies.\nconst s = $('Settings').first().json;\nconst lines = v => String(v || '').split('\\n').map(x => x.trim()).filter(Boolean);\nconst pairs = [];\nfor (const city of lines(s.cities)) for (const search of lines(s.searches)) pairs.push({ search, city });\n// Weekdays since Monday 1970-01-05; Saturday/Sunday reuse Friday's pair.\nconst d = Math.floor((Date.now() - Date.UTC(1970, 0, 5)) / 86400000);\nconst today = pairs[(Math.floor(d / 7) * 5 + Math.min(d % 7, 4)) % pairs.length];\nconst known = $input.all().map(i => String(i.json.domain || '').toLowerCase()).filter(Boolean);\nreturn [{ json: { known, search: today.search, city: today.city, searchStrings: [`${today.search} ${today.city}`], max: 20 } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000114",
      "name": "Known domains",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        80
      ]
    },
    {
      "parameters": {
        "resource": "Actors",
        "operation": "Run actor and get dataset",
        "actorId": "santamaria-automations~google-maps-scraper",
        "customBody": "={{ JSON.stringify({ searchStrings: $json.searchStrings, maxResultsPerQuery: $json.max, language: 'en' }) }}",
        "timeout": 900,
        "memory": 1024,
        "maxTotalChargeUsd": 0.2
      },
      "id": "b2000000-0000-4000-8000-000000000115",
      "name": "Google Maps search",
      "type": "@apify/n8n-nodes-apify.apify",
      "typeVersion": 2,
      "position": [
        1960,
        80
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Drop places without a website, closed places, duplicates and domains already in the sheet. Keep newPerDay.\nconst s = $('Settings').first().json;\nconst known = new Set($('Known domains').first().json.known);\nconst out = [];\nfor (const { json: p } of $input.all()) {\n  if (!p.website || (p.status && p.status !== 'OPERATIONAL')) continue;\n  const domain = String(p.website).replace(/^https?:\\/\\//i, '').replace(/^www\\./i, '').split('/')[0].toLowerCase();\n  if (!domain || known.has(domain)) continue;\n  known.add(domain);\n  out.push({ json: { company: p.title, website: p.website, domain, category: p.category || '', city: $('Known domains').first().json.city, rating: p.rating ?? '', google_maps_url: p.link || '' } });\n  if (out.length >= s.newPerDay) break;\n}\nreturn out;"
      },
