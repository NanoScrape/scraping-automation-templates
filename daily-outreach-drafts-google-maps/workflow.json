    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Pick one role inbox per company. Personal addresses (firstname@, first.last@) are never used.\nconst ROLE = ['events', 'hello', 'info', 'enquiries', 'enquiry', 'inquiries', 'inquiry', 'hi', 'admin', 'studio', 'reception', 'post', 'welcome', 'contact', 'office', 'sales', 'bookings', 'booking', 'team', 'mail', 'kontakt', 'operations', 'ops', 'staffing', 'marketing', 'partnerships', 'business', 'newbusiness', 'general', 'reservations'];\nconst found = {};\nfor (const { json: r } of $input.all()) {\n  const host = String(r.domain || '').replace(/^www\\./, '').toLowerCase();\n  const emails = (r.emails || []).map(e => String(typeof e === 'string' ? e : e.email || '').toLowerCase());\n  const role = ROLE.map(p => emails.find(e => e.split('@')[0] === p)).find(Boolean);\n  if (host && role) found[host] = role;\n}\nreturn $('New companies with a website').all().map(({ json: c }) => ({ json: { ...c, inbox: found[c.domain] || '', inbox_source: found[c.domain] ? 'contact extractor' : '' } }));"
      },
