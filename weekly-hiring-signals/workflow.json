      "id": "c3000000-0000-4000-8000-000000000113",
      "name": "Search LinkedIn jobs",
      "type": "@apify/n8n-nodes-apify.apify",
      "typeVersion": 2,
      "position": [
        1600,
        80
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Group job posts by company. Drop agencies, the exclude list and companies below minOpenRoles.\nconst s = $('Settings').first().json;\nconst exclude = new Set(String(s.excludeCompanies || '').split(/[,\\n]/).map(x => x.trim().toLowerCase()).filter(Boolean));\n// Agencies: industry, name or LinkedIn description mentions staffing/recruitment.\nconst AGENCY = /staffing|recruit|headhunt|executive search|talent (partner|solutions|acquisition partner)|connecting [^.|]{0,40}talent|matched to employers/i;\nconst isAgency = j => AGENCY.test(j.company_industry || '') || AGENCY.test(j.company || '') || AGENCY.test(String(j.company_description || '').slice(0, 300));\n// LinkedIn serves the same page under uk./se./www. subdomains; keep one form so the weekly key stays stable.\nconst page = u => { const m = String(u || '').match(/linkedin\\.com\\/company\\/([^/?#]+)/i); return m ? 'https://www.linkedin.com/company/' + m[1].toLowerCase() : String(u || ''); };\nconst groups = {};\nfor (const { json: j } of $input.all()) {\n  const name = String(j.company || '').trim();\n  if (!name || exclude.has(name.toLowerCase()) || isAgency(j)) continue;\n  const key = (page(j.company_url) || name).toLowerCase();\n  const g = groups[key] || (groups[key] = { company: name, ids: new Set(), titles: new Set(), locations: new Set(), newest: '', industry: j.company_industry || '', size: j.company_employee_count || '', website: j.company_website || '', linkedin_page: page(j.company_url), example_job: j.source_url || '' });\n  if (g.ids.has(j.id)) continue;\n  g.ids.add(j.id);\n  if (j.title) g.titles.add(j.title);\n  if (j.location) g.locations.add(String(j.location).split(',')[0]);\n  if ((j.posted_at || '') > g.newest) g.newest = j.posted_at;\n}\nconst week = $now.toFormat(\"kkkk-'W'WW\");\nreturn Object.values(groups)\n  .filter(g => g.ids.size >= s.minOpenRoles)\n  .sort((a, b) => b.ids.size - a.ids.size)\n  .map(g => ({ json: { key: week + ' | ' + (g.linkedin_page || g.company).toLowerCase(), week, company: g.company, open_roles: g.ids.size, titles: [...g.titles].slice(0, 5).join('; '), locations: [...g.locations].slice(0, 3).join(', '), newest_post: g.newest.slice(0, 10), industry: g.industry, size: g.size ? \"'\" + g.size : '',  // ' = keep \"51-200\" as text in Sheets\n website: g.website, linkedin_page: g.linkedin_page, example_job: g.example_job } }));"
      },
