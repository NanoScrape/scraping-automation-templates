    {
      "parameters": {
        "resource": "Actors",
        "operation": "Run actor and get dataset",
        "actorId": "santamaria-automations~linkedin-scraper",
        "customBody": "={{ JSON.stringify({ searchQueries: $('Settings').first().json.searches.split('\\n').map(s => s.trim()).filter(Boolean), location: $('Settings').first().json.location, datePosted: 'past-week', sortBy: 'newest', maxResultsPerQuery: $('Settings').first().json.maxPostsPerSearch, includeCompanyDetails: true }) }}",
