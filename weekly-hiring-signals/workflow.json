    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// One Slack message with the top companies.\nconst s = $('Settings').first().json;\nconst rows = $('Group by company').all().map(i => i.json);\nconst top = rows.slice(0, s.slackTop);\nconst lines = top.map((r, n) => `${n + 1}. *${r.company}*: ${r.open_roles} open roles (${r.titles})${r.size ? ' · ' + r.size : ''}${r.industry ? ' · ' + r.industry : ''}${r.linkedin_page ? ' · <' + r.linkedin_page + '|LinkedIn>' : ''}`);\nconst head = `*Hiring signals ${rows[0]?.week || ''}*: ${rows.length} companies with ${s.minOpenRoles}+ open roles in ${s.location} (last 7 days).`;\nreturn [{ json: { text: [head, ...lines, rows.length > top.length ? `…and ${rows.length - top.length} more in the Sheet.` : ''].filter(Boolean).join('\\n') } }];"
      },
